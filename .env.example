# Copy this file to .env and set a long, unique secret before deployment.
SECRET_KEY=replace-with-a-long-random-secret
# Optional. Defaults to SQLite in instance/food_donation.db.
# For MySQL: mysql+pymysql://username:password@localhost/food_donation
DATABASE_URL=
# Set to 1 only when serving over HTTPS.
COOKIE_SECURE=0
